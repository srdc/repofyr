<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.repofyr</groupId>
        <artifactId>repofyr-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>repofyr-server-stu3_2.13</artifactId>
    <name>Repofyr Server STU3</name>
    <description>Runnable Repofyr server for HL7 FHIR STU3, preconfigured with
        the STU3 standard definitions and configurator.</description>
    <packaging>jar</packaging>

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <!-- Allows compiling/testing/running/documenting Scala code in Maven. -->
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <!-- Generates an executable jar with Maven, containing all dependencies. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.repofyr.stu3.Boot</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!--Generate standalone executable jar-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/log4j-provider.properties</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <finalName>repofyr-server-standalone</finalName>
                            <transformers>
                                <!-- add Main-Class to manifest file -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.repofyr.stu3.Boot</mainClass>
                                </transformer>

                                <!-- Append application.conf to jar configurations-->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>application.conf</resource>
                                </transformer>

                                <!-- Append reference.conf to jar configurations for Akka to run -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>reference.conf</resource>
                                </transformer>

                                <!-- Repofyr's own shipped defaults, loaded by OnfhirConfig between
                                     the deployment's application.conf and the library references.
                                     Only repofyr-core publishes it today; appending rather than
                                     picking one keeps that from becoming a silent clobber. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>repofyr-reference.conf</resource>
                                </transformer>

                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <!-- OnFhirSTU3Test boots the suite against an embedded MongoDB. Test scope only:
             the runnable server must not carry it. Declared here rather than inherited
             from repofyr-server-r4, whose copy is test scope and so does not propagate. -->
        <dependency>
            <groupId>io.repofyr</groupId>
            <artifactId>repofyr-embedded-mongo_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Scala Language -->
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
        </dependency>
        <!--Onfhir modules -->
        <dependency>
            <groupId>io.onfhir</groupId>
            <artifactId>onfhir-common_${scala.binary.version}</artifactId>
        </dependency>
        <dependency>
            <groupId>io.repofyr</groupId>
            <artifactId>repofyr-core_${scala.binary.version}</artifactId>
        </dependency>
        <dependency>
            <groupId>io.repofyr</groupId>
            <artifactId>repofyr-server-r4_${scala.binary.version}</artifactId>
        </dependency>
        <!-- STU3 foundation-resource parsers, moved to the reusable libraries. -->
        <dependency>
            <groupId>io.onfhir</groupId>
            <artifactId>onfhir-stu3_${scala.binary.version}</artifactId>
        </dependency>
        <!-- Supplies definitions-stu3.json.zip and conformance-statement-stu3.json on
             the classpath; the server no longer ships its own copies. -->
        <dependency>
            <groupId>io.onfhir</groupId>
            <artifactId>onfhir-definitions-stu3</artifactId>
        </dependency>

        <!--Testing toolkits for Akka-->
        <dependency>
            <groupId>com.typesafe.akka</groupId>
            <artifactId>akka-testkit_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.typesafe.akka</groupId>
            <artifactId>akka-http-testkit_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Unit Testing -->
        <dependency>
            <groupId>org.specs2</groupId>
            <artifactId>specs2-core_${scala.binary.version}</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.specs2</groupId>
            <artifactId>specs2-junit_${scala.binary.version}</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
