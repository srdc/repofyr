# Stage 0
FROM maven:3.6-openjdk-11 AS builder

ENV ONFHIR_HOME /usr/local/onfhir
RUN mkdir -p "$ONFHIR_HOME"
WORKDIR $ONFHIR_HOME

COPY . ./

# Build without running the unit and integration tests
RUN mvn package -Pxtest

# Stage 1
FROM eclipse-temurin:11-jre

# curl, for the HEALTHCHECK below. Chained with && so a failed index update fails the build rather
# than falling through to an install against a stale index, and the lists are dropped again because
# they would otherwise sit in this layer for the life of the image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

ENV ONFHIR_HOME /usr/local/onfhir
RUN mkdir -p "$ONFHIR_HOME"
WORKDIR $ONFHIR_HOME
# Define the FHIR_VERSION variable to specify the version of the FHIR server
ARG FHIR_VERSION
COPY --from=builder $ONFHIR_HOME/repofyr-server-$FHIR_VERSION/target/repofyr-server-standalone.jar .

COPY docker/docker-entrypoint.sh .
RUN chmod +x docker-entrypoint.sh

# Serving a CapabilityStatement is the cheapest proof the server is actually up rather than merely
# listening: it means configuration loaded and the database answered. HEAD, because the route
# accepts it and nothing here needs the body. The start period is generous because initialization
# validates every configured profile, which is slow on a large implementation guide.
#
# The scheme follows SSL_KEYSTORE, the same condition the server itself uses, because enabling TLS
# replaces the plain listener on the same port rather than adding a second one - so a fixed http://
# probe would report every TLS deployment as permanently unhealthy. -k because this dials localhost,
# where the point is liveness, not validating a certificate chain.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD if [ -n "$SSL_KEYSTORE" ]; then SCHEME=https; else SCHEME=http; fi; \
        curl -fsS -k --head "$SCHEME://localhost:${SERVER_PORT:-8080}/${SERVER_BASE_URI:-fhir}/metadata" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
